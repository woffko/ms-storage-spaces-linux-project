[Unit]
Description=Attach Microsoft Storage Spaces pools read-only
Documentation=man:spaces(8) https://github.com/woffko/ms-storage-spaces-linux-project
DefaultDependencies=no
After=systemd-udevd.service systemd-modules-load.service
Before=local-fs-pre.target
Wants=local-fs-pre.target

[Service]
Type=oneshot
# Let the other members of a pool finish appearing first.
ExecStartPre=-/usr/bin/udevadm settle --timeout=30
ExecStart=/usr/local/sbin/spaces attach
TimeoutStartSec=120

# This runs as root and parses the metadata of every disk that carries a
# Storage Spaces partition, whoever made it: it keeps what it needs (block
# devices, device-mapper, /run, the module loader) and nothing else. The
# servers it starts (systemd-run) get the same kind of limits from the
# program itself. Tested with the dm and ublk backends
# (docs/user-guide.md, "Hardening").
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run
# Pool disks may be image files in a home directory.
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
CapabilityBoundingSet=~CAP_SYS_PTRACE CAP_SYS_BOOT CAP_SYS_TIME CAP_SYS_PACCT CAP_SYS_TTY_CONFIG \
    CAP_SYSLOG CAP_NET_ADMIN CAP_NET_RAW CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE \
    CAP_LINUX_IMMUTABLE CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_WAKE_ALARM CAP_BLOCK_SUSPEND \
    CAP_PERFMON CAP_BPF CAP_CHECKPOINT_RESTORE CAP_SETPCAP CAP_SYS_CHROOT CAP_SETUID CAP_SETGID \
    CAP_KILL

[Install]
WantedBy=local-fs-pre.target
