#!/bin/sh
# mount(8) helper for ReFS: "mount -t ReFS /dev/sdb2 /mnt", fstab entries
# and udisks2 mount ReFS volumes through FUSE with "refs mount". Install as
# /sbin/mount.ReFS (the type blkid reports) and /sbin/mount.refs.
#
# Usage (as mount(8) calls it): mount.refs SOURCE DIR [-sfnv] [-o OPTIONS]
#
# Read-only unless the options hold both "rw" and "refs.rw": writing is
# experimental, and udisks2 asks for "rw" by default. A volume that is not
# healthy (refs check --quick says why) is refused unless the options hold
# "force", and is then read-only. Mounted by root (as
# mount(8) and udisks2 do), every user may enter it (FUSE's allow_other,
# with the permissions the mount shows), unless "noallow_other"; mounted
# by a user, only "allow_other" lets others in. Other options (nosuid,
# nodev, uhelper=..., ...) are accepted and ignored; FUSE mounts are
# nosuid and nodev anyway.
set -eu

# mount(8) runs helpers with a short PATH: look where refs is installed.
refs=${REFS:-}
if [ -z "$refs" ]; then
  for c in "$(command -v refs 2>/dev/null || true)" /usr/bin/refs /usr/local/bin/refs; do
    if [ -n "$c" ] && [ -x "$c" ]; then refs=$c; break; fi
  done
fi
[ -n "$refs" ] || { echo "mount.refs: refs is not installed" >&2; exit 1; }
[ $# -ge 2 ] || { echo "usage: mount.refs SOURCE DIR [-o OPTIONS]" >&2; exit 1; }
source=$1
dir=$2
shift 2
options=
while [ $# -gt 0 ]; do
  case $1 in
    -o) options=${2:-}; shift 2 ;;
    -o*) options=${1#-o}; shift ;;
    -s|-f|-n|-v) shift ;;
    -N|-t) shift 2 ;;
    *) shift ;;
  esac
done

rw=0 refs_rw=0 allow_other=0 force=0
if [ "$(id -u)" = 0 ]; then allow_other=1; fi
old_ifs=$IFS
IFS=,
for o in $options; do
  case $o in
    rw) rw=1 ;;
    ro) rw=0 ;;
    refs.rw) refs_rw=1 ;;
    allow_other) allow_other=1 ;;
    noallow_other) allow_other=0 ;;
    force) force=1 ;;
  esac
done
IFS=$old_ifs

set --
if [ $force = 1 ]; then
  set -- "$@" --force
elif [ $rw = 1 ] && [ $refs_rw = 1 ]; then
  set -- "$@" --rw
fi
if [ $allow_other = 1 ]; then set -- "$@" --allow-other; fi

# refs serves the mount in the foreground: run it in its own session and
# return once the mount is there (or report why it is not). refs reports
# how far it is in a status file (refs mount --status-file): opening, with
# the bytes read so far, then mounted or failed. So nothing here guesses
# with a timeout: a large volume on a slow disk can take minutes the first
# time, and the count shows it is under way (every 10 s on a terminal).
# MOUNT_REFS_TIMEOUT=SECONDS sets a limit all the same.
#
# As root (as mount(8) and udisks2 run this) it parses a disk that may be
# anyone's, so under systemd it runs as a transient service with the limits
# that leave the mount visible to the host: no network, no new privileges,
# no namespaces, only the capabilities mounting and reading disks need.
# (ProtectSystem and the like would hide the mount in a private namespace,
# and since systemd 254 PrivateNetwork implies one unless PrivateMounts=no:
# the mount would be made where the host never sees it.)
work=$(mktemp -d)
log=$work/log
status=$work/status
unit=
if [ "$(id -u)" = 0 ] && [ -d /run/systemd/system ] && command -v systemd-run >/dev/null 2>&1; then
  unit=refs-mount-$$
  if ! systemd-run --quiet --collect --unit="$unit" \
    -p NoNewPrivileges=yes -p PrivateNetwork=yes -p PrivateMounts=no -p RestrictNamespaces=yes \
    -p RestrictRealtime=yes -p RestrictSUIDSGID=yes -p LockPersonality=yes \
    -p MemoryDenyWriteExecute=yes -p SystemCallArchitectures=native -p UMask=0077 \
    -p "CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID" \
    -p "StandardOutput=file:$log" -p "StandardError=file:$log" \
    -- "$refs" mount --status-file "$status" "$@" "$source" "$dir"; then
    unit=
  fi
fi
if [ -z "$unit" ]; then
  setsid "$refs" mount --status-file "$status" "$@" "$source" "$dir" >"$log" 2>&1 </dev/null &
  pid=$!
fi
alive() {
  if [ -n "$unit" ]; then
    systemctl -q is-active "$unit" 2>/dev/null
  else
    kill -0 "$pid" 2>/dev/null
  fi
}
field() { sed -n "s/^$1=//p" "$status" 2>/dev/null || true; }
start=$(date +%s)
limit=${MOUNT_REFS_TIMEOUT:-0}
shown=0
reason=
while :; do
  case $(field state) in
    mounted)
      if mountpoint -q "$dir"; then
        rm -rf "$work"
        exit 0
      fi
      reason="refs mounted the volume, but the mount is not visible here (a private mount namespace?)"
      break ;;
    failed)
      [ -s "$log" ] || reason=$(field error)
      break ;;
  esac
  # Ended without a word: its log says why.
  alive || break
  elapsed=$(($(date +%s) - start))
  if [ "$limit" -gt 0 ] && [ "$elapsed" -ge "$limit" ]; then
    reason="refs did not mount the volume within $limit s (MOUNT_REFS_TIMEOUT)"
    break
  fi
  if [ -t 2 ] && [ "$elapsed" -ge $((shown + 10)) ]; then
    shown=$elapsed
    bytes=$(field read)
    echo "mount.refs: opening the volume, $((${bytes:-0} / 1048576)) MiB read in $elapsed s" >&2
  fi
  sleep 0.2
done
[ -z "$reason" ] || echo "mount.refs: $reason" >&2
cat "$log" >&2
if [ -n "$unit" ]; then
  systemctl stop "$unit" 2>/dev/null || true
else
  kill "$pid" 2>/dev/null || true
fi
rm -rf "$work"
exit 32
